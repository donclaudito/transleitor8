{
  "name": "FrasePreDefinida",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "exame_fisico",
        "plano_conduta",
        "evolucao",
        "receita"
      ],
      "description": "Categoria da frase: exame_fisico, plano_conduta, evolucao (texto completo salvo do editor) ou receita (ambulat\u00f3rio \u2014 entra na Prescri\u00e7\u00e3o)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo/grupo da frase (ex.: UROLOGIA). Vazio ou ausente = grupo GERAL"
    },
    "texto": {
      "type": "string",
      "description": "Texto da frase pr\u00e9-definida"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "hospital",
        "clinica",
        "geral"
      ],
      "description": "Ambiente da frase: hospital, clinica (ambulat\u00f3rio) ou geral (vale em qualquer ambiente). Registros antigos sem ambiente s\u00e3o tratados como geral"
    },
    "especialidade": {
      "type": "string",
      "description": "Slug da especialidade da frase (ex.: urologia) ou 'geral' (vale em qualquer especialidade). Registros antigos sem valor s\u00e3o tratados como geral"
    },
    "favorita": {
      "type": "boolean",
      "default": false,
      "description": "Se a evolu\u00e7\u00e3o est\u00e1 marcada como favorita (aparece sempre no topo da lista)"
    }
  },
  "required": [
    "categoria",
    "texto"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}