{
  "name": "Evolution",
  "type": "object",
  "properties": {
    "sector": {
      "type": "string",
      "description": "Hospital sector/unit"
    },
    "bed": {
      "type": "string",
      "description": "Patient bed number"
    },
    "patient_initials": {
      "type": "string",
      "description": "Patient initials"
    },
    "comorbidities": {
      "type": "string",
      "description": "Patient comorbidities"
    },
    "labs": {
      "type": "string",
      "description": "Lab results and complementary exams"
    },
    "prescription": {
      "type": "string",
      "description": "Current prescription text"
    },
    "clinical_description": {
      "type": "string",
      "description": "Free-form clinical description"
    },
    "soap_text": {
      "type": "string",
      "description": "AI-generated SOAP evolution text"
    },
    "form_data": {
      "type": "object",
      "description": "Snapshot completo do formul\u00e1rio (dados de entrada) para retomar a edi\u00e7\u00e3o do paciente entre dispositivos"
    }
  },
  "required": [
    "clinical_description",
    "soap_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      },
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}