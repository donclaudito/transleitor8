{
  "name": "LLMUsageLog",
  "type": "object",
  "properties": {
    "flow": {
      "type": "string",
      "enum": [
        "evolucao",
        "imagem"
      ],
      "description": "Fluxo de origem da chamada de IA"
    },
    "provider": {
      "type": "string",
      "description": "Nome do provedor (ex: gemini_3_flash, Mistral)"
    },
    "model": {
      "type": "string",
      "description": "Nome do modelo usado"
    },
    "tokens": {
      "type": "number",
      "description": "Tokens consumidos (quando informado pela API)"
    },
    "response_time_ms": {
      "type": "number",
      "description": "Tempo de resposta em milissegundos"
    },
    "status": {
      "type": "string",
      "enum": [
        "sucesso",
        "erro"
      ],
      "description": "Status da chamada"
    },
    "accuracy_score": {
      "type": "number",
      "description": "Nota de precis\u00e3o atribu\u00edda pelo m\u00e9dico (1 a 10)"
    }
  },
  "required": [
    "flow",
    "provider",
    "model",
    "response_time_ms",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}