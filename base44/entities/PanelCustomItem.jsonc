{
  "name": "PanelCustomItem",
  "type": "object",
  "properties": {
    "panel": {
      "type": "string",
      "description": "Identificador da pestana (uti, cirurgia, ps, emergencia, sintomas, gastro)"
    },
    "name": {
      "type": "string",
      "description": "Texto do item personalizado criado pelo m\u00e9dico"
    }
  },
  "required": [
    "panel",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}