{
  "name": "ComorbidityMedication",
  "type": "object",
  "properties": {
    "comorbidity_name": {
      "type": "string",
      "description": "Nome da comorbidade associada"
    },
    "medications": {
      "type": "string",
      "description": "Lista de medicamentos de uso cr\u00f4nico, separados por v\u00edrgula"
    }
  },
  "required": [
    "comorbidity_name",
    "medications"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      },
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}