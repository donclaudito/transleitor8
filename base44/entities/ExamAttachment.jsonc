{
  "name": "ExamAttachment",
  "type": "object",
  "properties": {
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo enviado (imagem/PDF); vazio quando o armazenamento falhou"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "laudo",
        "exame"
      ],
      "default": "exame",
      "description": "Tipo do documento capturado: laudo ou exame"
    },
    "tipo_arquivo": {
      "type": "string",
      "enum": [
        "imagem",
        "pdf"
      ],
      "description": "Origem da captura: imagem (foto/galeria) ou PDF"
    },
    "extracao": {
      "type": "string",
      "description": "Texto extra\u00eddo por IA, j\u00e1 anonimizado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "inserida"
      ],
      "default": "pendente",
      "description": "Status na fila: pendente (aguardando inser\u00e7\u00e3o) ou inserida"
    },
    "especialidade_destino": {
      "type": "string",
      "description": "Slug da especialidade para onde a captura ser\u00e1 inserida (ex.: gastro-endoscopia). Vazio = sem destino definido"
    }
  },
  "required": [
    "tipo",
    "extracao",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}