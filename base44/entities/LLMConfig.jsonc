{
  "name": "LLMConfig",
  "type": "object",
  "properties": {
    "provider_name": {
      "type": "string",
      "description": "Nome exibido do provedor (ex: Magistral, OpenAI, DeepSeek)"
    },
    "api_url": {
      "type": "string",
      "description": "URL base da API de chat completions"
    },
    "api_key_env_var": {
      "type": "string",
      "description": "Legado: nome da vari\u00e1vel de ambiente. Mantido para compatibilidade; novos provedores usam api_key_encrypted."
    },
    "api_key_encrypted": {
      "type": "string",
      "description": "Chave de API criptografada (AES-256-GCM, base64 IV+ciphertext). Nunca armazenar a chave em texto plano."
    },
    "model_name": {
      "type": "string",
      "description": "Nome do modelo a ser usado (ex: gpt-4o, magistral-v1)"
    },
    "is_active": {
      "type": "boolean",
      "description": "Se o provedor est\u00e1 ativo para uso"
    }
  },
  "required": [
    "provider_name",
    "api_url",
    "model_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}