{
  "name": "AppLink",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "App link name"
    },
    "url": {
      "type": "string",
      "description": "App URL"
    },
    "icone": {
      "type": "string",
      "description": "Emoji icon"
    },
    "categoria": {
      "type": "string",
      "description": "Category"
    },
    "ativo": {
      "type": "boolean",
      "description": "Whether the link is active"
    },
    "ordem": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "nome",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}